# kim2024interpreting Configuration (Nature 2024 - CC-BY-NC-ND 4.0)
# Copy this file to .env and customize values

# Active Learning Parameters
ALPHA=0.1
GAMMA=0.9
REWARD_SCALE=2
REWARD_THRESHOLD=0.4

# Sampling Configuration
SAMPLING_RATIO=10
GROUPS=10
VALIDATION_PERCENT=0.01

# Training Parameters
EPOCHS=200
CYCLES=10
BATCH_SIZE=128
LR=0.1
MOMENTUM=0.9
WEIGHT_DECAY=5e-4

# Data and Checkpoint Paths (optional - uses default PROJECT_ROOT if not set)
# DATA_DIR=/path/to/DATA
# LOSS_DIR=/path/to/loss
# CHECKPOINT_DIR=/path/to/checkpoint
